      <styleUrl>#waypointPin</styleUrl>
      <Point><coordinates>79.0770,30.5240,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>10. Gaurikund (Kedarnath trek starts)</name>
      <styleUrl>#waypointPin</styleUrl>
      <Point><coordinates>79.0235,30.6530,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>11. Chopta (Tungnath trek starts)</name>
      <styleUrl>#waypointPin</styleUrl>
      <Point><coordinates>79.1553,30.4729,0</coordinates></Point>
