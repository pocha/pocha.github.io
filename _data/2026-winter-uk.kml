<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Delhi - Uttarakhand Pilgrimage &amp; Hills Circuit</name>
    <description>Sequential waypoints for Kurviger road snapping: Rishikesh, Chakrata, Mussoorie, Uttarkashi, Gangotri, New Tehri, Kedarnath (Gaurikund trek), Tungnath (Chopta trek), Badrinath, Karnaprayag, Kausani, Munsiyari, Pithoragarh, Abbott Mount, Binsar, Mukteshwar, Kainchi Dham, Nainital and Jim Corbett.</description>

    <Style id="waypointPin">
      <IconStyle>
        <scale>1.1</scale>
        <Icon>
          <href>http://maps.google.com/mapfiles/kml/pushpin/red-pushpin.png</href>
        </Icon>
      </IconStyle>
    </Style>

    <Placemark>
      <name>1. Delhi (Start)</name>
      <styleUrl>#waypointPin</styleUrl>
      <Point><coordinates>77.2090,28.6139,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>2. Rishikesh</name>
      <styleUrl>#waypointPin</styleUrl>
      <Point><coordinates>78.0322,30.0869,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>3. Chakrata (Deoban / Budher Caves)</name>
      <styleUrl>#waypointPin</styleUrl>
      <Point><coordinates>77.8687,30.7016,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>4. Mussoorie</name>
      <styleUrl>#waypointPin</styleUrl>
      <Point><coordinates>78.0664,30.4598,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>5. Uttarkashi</name>
      <styleUrl>#waypointPin</styleUrl>
