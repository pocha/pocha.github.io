<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Delhi Circuit Expedition (Via Meghalaya &amp; Siliguri Bypass)</name>
    <description>Sequential itinerary waypoints bypassing Bangladesh and Kolkata.</description>

    <!-- Style for Waypoint Pins -->
    <Style id="waypointPin">
      <IconStyle>
        <scale>1.1</scale>
        <Icon>
          <href>http://maps.google.com/mapfiles/kml/pushpin/red-pushpin.png</href>
        </Icon>
      </IconStyle>
    </Style>

