<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Delhi - Rajasthan 14-Day Circuit</name>
    <description>Sequential waypoints for Kurviger road snapping covering castles, desert dunes, Indo-Pak border, and salt lakes.</description>

    <Style id="waypointPin">
      <IconStyle>
        <scale>1.1</scale>
        <Icon>
          <href>http://maps.google.com/mapfiles/kml/pushpin/red-pushpin.png</href>
        </Icon>
      </IconStyle>
    </Style>

    <Placemark>
      <name>1. Delhi (Start)</name>
      <styleUrl>#waypointPin</styleUrl>
      <Point><coordinates>77.2090,28.6139,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>2. Mandawa (Shekhawati)</name>
      <styleUrl>#waypointPin</styleUrl>
      <Point><coordinates>75.1481,28.0549,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>3. Bikaner (Junagarh Fort)</name>
      <styleUrl>#waypointPin</styleUrl>
      <Point><coordinates>73.3119,28.0229,0</coordinates></Point>
    </Placemark>
